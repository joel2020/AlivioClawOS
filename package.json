{
  "name": "clawbot-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "NODE_OPTIONS=--conditions=react-server tsx scripts/migrate-db.ts",
    "db:import": "NODE_OPTIONS=--conditions=react-server tsx scripts/import-state.ts",
    "db:bootstrap": "NODE_OPTIONS=--conditions=react-server tsx scripts/bootstrap-db.ts",
    "worker": "NODE_OPTIONS=--conditions=react-server tsx scripts/agent-worker.ts",
    "worker:once": "NODE_OPTIONS=--conditions=react-server tsx scripts/agent-worker.ts --once",
    "telegram:poll": "NODE_OPTIONS=--conditions=react-server tsx scripts/telegram-poller.ts",
    "telegram:poll:once": "NODE_OPTIONS=--conditions=react-server tsx scripts/telegram-poller.ts --once",
    "backup:state": "NODE_OPTIONS=--conditions=react-server tsx scripts/backup-state.ts",
    "backup:restore": "NODE_OPTIONS=--conditions=react-server tsx scripts/restore-state.ts",
    "digest:telegram": "NODE_OPTIONS=--conditions=react-server tsx scripts/daily-digest.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "^16.2.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^5.12.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.14"
    }
  }
}
